---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hibiscus from '../components/Hibiscus.astro';
import Petals from '../components/Petals.astro';
import HeartRule from '../components/HeartRule.astro';
import TrustRow from '../components/TrustRow.astro';
import Steps from '../components/Steps.astro';
import Reviews from '../components/Reviews.astro';
import ServiceArea from '../components/ServiceArea.astro';
import FaqList from '../components/FaqList.astro';
import ContactSection from '../components/ContactSection.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import floorBefore from '../assets/work/shower-floor-before.png';
import floorAfter from '../assets/work/shower-floor-after.png';
import cornerBefore from '../assets/work/shower-corner-before.png';
import cornerAfter from '../assets/work/shower-corner-after.png';
import { business, services, media, claims, cta, isPublished } from '../content/site';

const work = media.showerFloor;
const photos = {
  floor: { before: floorBefore, after: floorAfter },
  corner: { before: cornerBefore, after: cornerAfter },
} as const;
const showClaims = claims.filter(isPublished);
const moreServices = [services.commercial, services.care].filter((m) => isPublished(m));
const generalHighlights = ['Bathroom care', 'Kitchen detailing', 'Dusting', 'Vacuuming and mopping', 'Linen changes'];
const bondHighlights = [
  'Detailed kitchen cleaning',
  'Deep bathroom and shower clean',
  'Built-in cupboards and storage',
  'Floors and skirting boards',
  'Windowsills and tracks',
];
const pick = (list: readonly { title: string; onRequest?: boolean }[], titles: string[]) =>
  titles.map((t) => list.find((i) => i.title === t)).filter((i): i is { title: string; onRequest?: boolean } => Boolean(i));

const claimIcons: Record<string, string> = {
  'Fully insured': 'M12 2.5 4 5.5v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10v-6l-8-3Zm-3.2 9.7 2.3 2.3 4.6-4.8',
  'Pet-friendly products':
    'M8 9.2a1.9 2.4 0 1 0 0-.1M16 9.2a1.9 2.4 0 1 0 0-.1M4.6 13a1.7 2.1 0 1 0 0-.1M19.4 13a1.7 2.1 0 1 0 0-.1M12 13.2c-2.6 0-4.6 2.6-4.6 4.4 0 1.5 1.3 2 2.4 1.7l2.2-.6 2.2.6c1.1.3 2.4-.2 2.4-1.7 0-1.8-2-4.4-4.6-4.4Z',
  'Eco-friendly products': 'M5 19c0-8 5-13 14-14-1 9-6 14-14 14Zm0 0c3-4 6-7 9-9',
};
---

<BaseLayout
  title="Hibiscus Cleaning Services | Home cleaning in the Moreton Bay region"
  description="Thoughtful home cleaning and housekeeping, plus detailed bond and exit cleans, across the Moreton Bay region. Call 0435 895 629."
  businessSchema
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-heading" data-hib-zone>
    <Petals count={9} hearts />
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow" data-anim="rise">{business.name} <HeartRule variant="trail" /></p>
        <h1 id="hero-heading" data-anim="lines">A beautifully clean home.<br /> More time for&nbsp;you.</h1>
        <p class="lede hero__lede" data-anim="rise" style="--d:350ms">
          Thoughtful cleaning and housekeeping, from your weekly home reset to a detailed move‑out clean.
        </p>
        <div class="btn-row hero__ctas" data-anim="rise" style="--d:480ms">
          <a class="btn btn--primary" href={business.phone.href} data-cta="hero">
            <PhoneIcon />
            {cta.call}
          </a>
          <a class="btn btn--secondary" href="#callback">{cta.callback}</a>
        </div>
        <p class="hero__area" data-anim="rise" style="--d:600ms">
          Cleaning homes across the Moreton Bay region.
        </p>
        <div class="hero__trust" data-anim="rise" style="--d:700ms">
          <TrustRow />
        </div>
      </div>

      <div class="hero__flower">
        <div class="hero__glow" aria-hidden="true"></div>
        <Hibiscus id="hero-hib" interactive />
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services section" id="services" aria-labelledby="services-heading">
    <div class="wrap">
      <HeartRule variant="lead" class="ornament" />
      <div class="services__head">
        <h2 id="services-heading" data-anim="lines">Care for the everyday. Detail for the big days.</h2>
        <p class="services__intro" data-anim="rise" style="--d:200ms">
          Regular housekeeping keeps the house feeling calm week to week. When you’re moving out, a bond clean takes
          care of the detail.
        </p>
      </div>

      <div class="services__grid" data-stagger="140">
        <div data-anim="pop" class="pop-shell">
          <article class="service service--general" aria-labelledby="svc-general" data-tilt="5">
            <h3 id="svc-general">{services.general.name}</h3>
            <p class="service__summary">{services.general.summary}</p>
            <p class="service__meta">Available weekly, fortnightly or on a regular schedule, subject to availability.</p>
            <ul class="service__list">
              {
                pick(services.general.inclusions, generalHighlights).map((i) => (
                  <li>
                    {i.title}
                    {i.onRequest && <span class="service__tag"> on request</span>}
                  </li>
                ))
              }
            </ul>
            <a class="text-link" href={services.general.href}>What’s included in general cleaning</a>
          </article>
        </div>

        <div data-anim="pop" class="pop-shell">
          <article class="service service--bond" aria-labelledby="svc-bond" data-tilt="5">
            <h3 id="svc-bond">{services.bond.name}</h3>
            <p class="service__summary">{services.bond.summary}</p>
            <p class="service__meta">Preparing to hand back the keys? The team works through the property in detail.</p>
            <ul class="service__list">
              {pick(services.bond.inclusions, bondHighlights).map((i) => <li>{i.title}</li>)}
            </ul>
            <a class="text-link" href={services.bond.href}>What’s included in a bond clean</a>
          </article>
        </div>
      </div>

      {
        moreServices.length > 0 && (
          <ul class="services__more" data-stagger="120">
            {moreServices.map((m) => (
              <li data-anim="rise">
                <h3>{m.name}</h3>
                <p>
                  {m.summary}{' '}
                  <a href={business.phone.href} data-cta={m.slug}>
                    {cta.call}
                  </a>
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- Our work -->
  {
    isPublished(work) && (
      <section class="work section" id="our-work" aria-labelledby="work-heading">
        <Petals count={5} />
        <div class="wrap work__grid">
          <div class="work__copy">
            <HeartRule variant="lead" class="ornament" />
            <h2 id="work-heading" data-anim="lines">From grimy to gleaming.</h2>
            <p class="lede" data-anim="rise" style="--d:200ms">
              Rust stains, soap residue and grime worked into the grout, taken back to bright white tile.
            </p>
            <p data-anim="rise" style="--d:300ms">
              {work.caption} Hover or tap a photo pair to fan them out.
            </p>
            <p class="work__more" data-anim="rise" style="--d:400ms">
              More recent work is on{' '}
              <a href={business.social.instagram.url} rel="noopener" target="_blank">
                Instagram<span class="visually-hidden"> (opens in a new tab)</span>
              </a>{' '}
              and{' '}
              <a href={business.social.facebook.url} rel="noopener" target="_blank">
                Facebook<span class="visually-hidden"> (opens in a new tab)</span>
              </a>
              .
            </p>
          </div>

          <div class="work__pairs" data-stagger="180">
            {work.pairs.map((pair, i) => (
              <figure class="pair" data-anim="pop" style={`--pop-z:${i ? 5 : -5}deg`}>
                <div class="pair__card pair__card--before">
                  <Picture
                    src={photos[pair.key as keyof typeof photos].before}
                    alt={pair.alt.before}
                    widths={[360, 620]}
                    sizes="(min-width: 60em) 22rem, 70vw"
                    formats={['webp']}
                    fallbackFormat="jpg"
                    quality={74}
                    loading="lazy"
                  />
                  <span class="pair__label">Before</span>
                </div>
                <div class="pair__card pair__card--after">
                  <Picture
                    src={photos[pair.key as keyof typeof photos].after}
                    alt={pair.alt.after}
                    widths={[360, 620]}
                    sizes="(min-width: 60em) 22rem, 70vw"
                    formats={['webp']}
                    fallbackFormat="jpg"
                    quality={74}
                    loading="lazy"
                  />
                  <span class="pair__label pair__label--after">After</span>
                </div>
                <figcaption class="pair__caption">{pair.label}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Approach -->
  <section class="approach section" id="about" aria-labelledby="about-heading">
    <div class="wrap approach__grid">
      <div class="approach__lead">
        <h2 id="about-heading" data-anim="lines">It’s the little things that make home feel looked after.</h2>
        <div class="approach__flower">
          <Hibiscus id="about-hib" />
        </div>
      </div>
      <div class="approach__body">
        <p class="lede" data-anim="rise">
          Hibiscus Cleaning Services offers refined cleaning and housekeeping for homes across the Moreton Bay region,
          with the focus on detail.
        </p>
        <p data-anim="rise" style="--d:120ms">
          That means kitchen surfaces wiped down properly, bathroom fixtures left shining, dust cleared from the
          windowsills and ceiling fans, and fresh linen on the bed when you ask for it. Tell the team what matters most
          in your home and you can talk through your priorities before the first clean.
        </p>
        <p class="approach__sign" data-anim="rise" style="--d:200ms">
          <HeartRule variant="trail" />
          {business.tagline}
        </p>
      </div>
    </div>

    {
      showClaims.length > 0 && (
        <div class="wrap">
          <ul class="promises" data-stagger="130" aria-label="Our promises">
            {showClaims.map((c) => (
              <li data-anim="pop" class="pop-shell">
                <div class="promise" data-tilt="9">
                  <svg class="promise__icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={claimIcons[c.label] ?? ''} />
                  </svg>
                  <p class="promise__label">{c.label}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <Steps />

  <Reviews />

  <!-- Area + FAQ -->
  <section class="info section" aria-label="Service area and questions">
    <div class="wrap info__grid">
      <div data-anim="rise">
        <ServiceArea />
      </div>
      <div class="info__faq">
        <h2 data-anim="lines">Questions</h2>
        <div data-anim="rise" style="--d:150ms">
          <FaqList />
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: min(54rem, calc(100svh - var(--header-h)));
    padding-block: clamp(2rem, 1rem + 3vw, 4rem);
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-weight: 600;
    color: var(--burgundy);
    margin-bottom: var(--space-l);
  }



  .hero h1 {
    max-width: 11em;
  }

  .hero__lede {
    margin-top: var(--space-l);
    max-width: 26em;
  }

  .hero__ctas {
    margin-top: var(--space-xl);
  }

  .hero__area {
    margin-top: var(--space-l);
    max-width: 28em;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .hero__trust {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
    max-width: 36rem;
  }

  /* Keep drifting petals away from the text column. */
  .hero :global(.petals) {
    left: 48%;
  }

  .hero__flower {
    position: relative;
    justify-self: center;
    width: min(100%, 36rem);
  }

  .hero__glow {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--blush) 0%, rgb(244 229 233 / 0.6) 45%, transparent 70%);
    z-index: -1;
  }

  @media (max-width: 47.99em) {
    .hero {
      min-height: 0;
      padding-top: var(--space-l);
    }
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .hero :global(.petals) {
      left: 0;
      bottom: auto;
      height: 22rem;
    }
    .hero__flower {
      order: -1;
      width: min(68vw, 18rem);
      margin-bottom: calc(var(--space-l) * -1);
    }
  }

  /* ---------- Services ---------- */
  .services__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-xl) clamp(2rem, 1rem + 4vw, 5rem);
    align-items: end;
  }

  .services__head h2 {
    max-width: 13em;
  }

  .services__intro {
    max-width: 28em;
    color: var(--muted);
  }

  .services__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.25rem, 0.5rem + 2vw, 2rem);
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .pop-shell {
    display: flex;
  }

  .service {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    border-radius: var(--radius-img);
    overflow: hidden;
  }

  .service--general {
    background: var(--white);
    border: 1px solid var(--line);
  }

  .service--bond {
    background: var(--blush);
  }

  .service h3 {
    font-size: var(--step-3);
  }

  .service--bond h3 {
    font-size: var(--step-2);
  }

  .service__summary {
    margin-top: var(--space-m);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--charcoal);
    max-width: 22em;
  }

  .service__meta {
    margin-top: var(--space-s);
    color: var(--muted);
    max-width: 30em;
  }

  .service__list {
    list-style: none;
    margin: var(--space-xl) 0;
    border-top: 1px solid var(--line);
  }

  .service--bond .service__list {
    border-color: var(--blush-deep);
  }

  .service__list li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--line);
  }

  .service--bond .service__list li {
    border-color: var(--blush-deep);
  }

  .service__list li::before {
    content: '';
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    transform: translateY(0.05rem);
    background: currentColor;
    color: var(--heart);
    opacity: 0.75;
    -webkit-mask: var(--heart-mask) center / contain no-repeat;
    mask: var(--heart-mask) center / contain no-repeat;
  }

  .service__tag {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .service .text-link {
    margin-top: auto;
    align-self: flex-start;
    padding-block: 0.4rem;
  }

  .services__more {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl) clamp(1.25rem, 0.5rem + 2vw, 2rem);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }

  .services__more h3 {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }

  .services__more p {
    color: var(--charcoal);
    max-width: 32em;
  }

  .services__more a {
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 59.99em) {
    .services__head,
    .services__grid,
    .services__more {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Our work: fanned before/after photo pairs ---------- */
  .work {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--blush);
  }

  .work :global(.petals) {
    left: 40%;
  }

  .work__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .work__copy > * + * {
    margin-top: var(--space-l);
  }

  .work__copy h2 {
    max-width: 9em;
  }

  .work__copy p {
    max-width: 30em;
  }

  .work__more {
    color: var(--muted);
  }

  .work__pairs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .pair {
    position: relative;
    margin: 0;
    aspect-ratio: 1 / 1.08;
    cursor: pointer;
  }

  .pair__card {
    position: absolute;
    width: 74%;
    padding: 8px 8px 2.25rem;
    background: var(--white);
    border-radius: 6px;
    box-shadow: 0 18px 40px -22px rgb(48 40 43 / 0.55), 0 2px 6px rgb(48 40 43 / 0.08);
    transition: transform 800ms var(--spring);
  }

  .pair__card :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 3px;
  }

  .pair__card--before {
    top: 0;
    left: 0;
    transform: rotate(-6deg);
  }

  .pair__card--after {
    right: 0;
    bottom: 2rem;
    transform: rotate(4deg);
    z-index: 1;
  }

  .pair:hover .pair__card--before,
  .pair.is-open .pair__card--before {
    transform: rotate(-10deg) translate(-8%, -4%);
  }

  .pair:hover .pair__card--after,
  .pair.is-open .pair__card--after {
    transform: rotate(7deg) translate(8%, 5%) scale(1.03);
  }

  .pair__label {
    position: absolute;
    left: 12px;
    bottom: 0.55rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .pair__label--after {
    color: var(--burgundy);
  }

  .pair__caption {
    position: absolute;
    left: 0;
    bottom: 0;
    font-family: var(--font-serif);
    color: var(--burgundy);
  }

  @media (max-width: 59.99em) {
    .work__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 34em) {
    .work__pairs {
      grid-template-columns: 1fr;
      max-width: 24rem;
    }
  }

  /* ---------- Approach ---------- */
  .approach__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-xl) clamp(2rem, 1rem + 5vw, 6rem);
    align-items: start;
  }

  .approach h2 {
    max-width: 11em;
  }

  .approach__flower {
    width: min(14rem, 50%);
    margin-top: var(--space-xl);
  }

  .approach__body > * + * {
    margin-top: var(--space-l);
  }

  .approach__body p {
    max-width: 34em;
  }

  .approach__sign {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--burgundy);
  }

  .promises {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
    margin-top: clamp(2.5rem, 2rem + 3vw, 5rem);
  }

  .promise {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-l);
    width: 100%;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius-img);
    background: linear-gradient(160deg, var(--white), var(--blush));
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .promise__icon {
    width: 3rem;
    height: 3rem;
    padding: 0.7rem;
    border-radius: 50%;
    background: var(--burgundy);
    fill: none;
    stroke: var(--ivory);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .promise__label {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    color: var(--burgundy);
    line-height: 1.2;
  }

  @media (max-width: 59.99em) {
    .approach__grid {
      grid-template-columns: 1fr;
    }
    .approach__flower {
      display: none;
    }
  }

  @media (max-width: 40em) {
    .promises {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Area + FAQ ---------- */
  .info {
    border-top: 1px solid var(--line);
  }

  .info__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-3xl) clamp(2rem, 1rem + 5vw, 6rem);
    align-items: start;
  }

  .info__faq h2 {
    margin-bottom: var(--space-l);
  }

  @media (max-width: 59.99em) {
    .info__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Tap to fan a photo pair on touch screens (hover covers mouse users).
  document.querySelectorAll<HTMLElement>('.pair').forEach((pair) => {
    pair.addEventListener('click', () => pair.classList.toggle('is-open'));
  });
</script>
