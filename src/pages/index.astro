---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import TrustRow from '../components/TrustRow.astro';
import Steps from '../components/Steps.astro';
import Reviews from '../components/Reviews.astro';
import ServiceArea from '../components/ServiceArea.astro';
import FaqList from '../components/FaqList.astro';
import ContactSection from '../components/ContactSection.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import beforeAligned from '../assets/work/shower-glass-before-aligned.png';
import afterAligned from '../assets/work/shower-glass-after-aligned.png';
import beforeFull from '../assets/work/shower-glass-before-full.png';
import afterFull from '../assets/work/shower-glass-after-full.png';
import { business, services, media, claims, cta, isPublished } from '../content/site';

const shower = media.showerGlass;
const showClaims = claims.filter(isPublished);
const moreServices = [services.commercial, services.care].filter((m) => isPublished(m));
const generalHighlights = ['Bathroom care', 'Kitchen detailing', 'Dusting', 'Vacuuming and mopping', 'Linen changes'];
const bondHighlights = [
  'Detailed kitchen cleaning',
  'Deep bathroom and shower clean',
  'Built-in cupboards and storage',
  'Floors and skirting boards',
  'Windowsills and tracks',
];
const pick = (list: readonly { title: string; onRequest?: boolean }[], titles: string[]) =>
  titles.map((t) => list.find((i) => i.title === t)).filter((i): i is { title: string; onRequest?: boolean } => Boolean(i));
---

<BaseLayout
  title="Hibiscus Cleaning Services | Home cleaning in Kallangur and North Lakes"
  description="Thoughtful home cleaning and housekeeping, plus detailed bond and exit cleans, across Kallangur, North Lakes, Moreton Bay and North Brisbane. Call 0435 895 629."
  businessSchema
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow">{business.name}</p>
        <h1 id="hero-heading">A beautifully clean home. More&nbsp;time for&nbsp;you.</h1>
        <p class="lede hero__lede">
          Thoughtful cleaning and housekeeping, from your weekly home reset to a detailed move‑out clean.
        </p>
        <div class="btn-row hero__ctas">
          <a class="btn btn--primary" href={business.phone.href} data-cta="hero">
            <PhoneIcon />
            {cta.call}
          </a>
          <a class="btn btn--secondary" href="#callback">{cta.callback}</a>
        </div>
        <p class="hero__area">
          Cleaning homes in Kallangur, North Lakes and nearby suburbs across Moreton Bay and North Brisbane.
        </p>
        <div class="hero__trust">
          <TrustRow />
        </div>
      </div>

      {
        isPublished(shower) && (
          <div class="hero__media">
            <Reveal
              before={beforeAligned}
              after={afterAligned}
              altBefore={shower.alt.before}
              altAfter={shower.alt.after}
              mode={shower.mode}
              priority
            >
              <figcaption slot="caption" class="hero__caption">
                {shower.caption}{' '}
                <a href={shower.sourceUrl} rel="noopener" target="_blank">
                  See the post<span class="visually-hidden"> on Instagram (opens in a new tab)</span>
                </a>
              </figcaption>
            </Reveal>
          </div>
        )
      }
    </div>
  </section>

  <!-- Services -->
  <section class="services section" id="services" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="services__head">
        <h2 id="services-heading">Care for the everyday. Detail for the big&nbsp;days.</h2>
        <p class="services__intro">
          Regular housekeeping keeps the house feeling calm week to week. When you’re moving out, a bond clean takes
          care of the detail.
        </p>
      </div>

      <div class="services__grid">
        <article class="service service--general" aria-labelledby="svc-general">
          <h3 id="svc-general">{services.general.name}</h3>
          <p class="service__summary">{services.general.summary}</p>
          <p class="service__meta">Available weekly, fortnightly or on a regular schedule, subject to availability.</p>
          <ul class="service__list">
            {
              pick(services.general.inclusions, generalHighlights).map((i) => (
                <li>
                  {i.title}
                  {i.onRequest && <span class="service__tag"> on request</span>}
                </li>
              ))
            }
          </ul>
          <a class="text-link" href={services.general.href}>What’s included in general cleaning</a>
        </article>

        <article class="service service--bond" aria-labelledby="svc-bond">
          <h3 id="svc-bond">{services.bond.name}</h3>
          <p class="service__summary">{services.bond.summary}</p>
          <p class="service__meta">Preparing to hand back the keys? The team works through the property in detail.</p>
          <ul class="service__list">
            {pick(services.bond.inclusions, bondHighlights).map((i) => <li>{i.title}</li>)}
          </ul>
          <a class="text-link" href={services.bond.href}>What’s included in a bond clean</a>
        </article>
      </div>

      {
        moreServices.length > 0 && (
          <ul class="services__more">
            {moreServices.map((m) => (
              <li>
                <h3>{m.name}</h3>
                <p>
                  {m.summary}{' '}
                  <a href={business.phone.href} data-cta={m.slug}>
                    {cta.call}
                  </a>
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- Our work -->
  {
    isPublished(shower) && (
      <section class="work section" id="our-work" aria-labelledby="work-heading">
        <div class="wrap work__grid">
          <div class="work__photos">
            <figure>
              <Picture
                src={beforeFull}
                alt={shower.alt.before}
                widths={[252, 504]}
                sizes="(min-width: 60em) 18rem, 45vw"
                formats={['webp']}
                fallbackFormat="jpg"
                quality={72}
                loading="lazy"
              />
              <figcaption>Before</figcaption>
            </figure>
            <figure>
              <Picture
                src={afterFull}
                alt={shower.alt.after}
                widths={[252, 504]}
                sizes="(min-width: 60em) 18rem, 45vw"
                formats={['webp']}
                fallbackFormat="jpg"
                quality={72}
                loading="lazy"
              />
              <figcaption>After</figcaption>
            </figure>
          </div>
          <div class="work__copy">
            <h2 id="work-heading">Shower glass, back to clear.</h2>
            <p class="lede">{shower.detail}</p>
            <p>
              Soap scum and hard-water marks build up on shower screens over time. A detailed shower clean is part of
              every bond and exit clean, and if your glass is looking tired at any other time, ask about it when you
              call.
            </p>
            <p class="work__more">
              More recent work is on{' '}
              <a href={business.social.instagram.url} rel="noopener" target="_blank">
                Instagram<span class="visually-hidden"> (opens in a new tab)</span>
              </a>{' '}
              and{' '}
              <a href={business.social.facebook.url} rel="noopener" target="_blank">
                Facebook<span class="visually-hidden"> (opens in a new tab)</span>
              </a>
              .
            </p>
          </div>
        </div>
      </section>
    )
  }

  <!-- Approach -->
  <section class="approach section" id="about" aria-labelledby="about-heading">
    <div class="wrap approach__grid">
      <h2 id="about-heading">It’s the little things that make home feel looked&nbsp;after.</h2>
      <div class="approach__body">
        <p class="lede">
          Hibiscus Cleaning Services offers refined cleaning and housekeeping for homes around Kallangur and North Lakes,
          with the focus on detail.
        </p>
        <p>
          That means kitchen surfaces wiped down properly, bathroom fixtures left shining, dust cleared from the
          windowsills and ceiling fans, and fresh linen on the bed when you ask for it. Tell the team what matters most
          in your home and you can talk through your priorities before the first clean.
        </p>
        {
          showClaims.length > 0 && (
            <ul class="approach__claims">
              {showClaims.map((c) => (
                <li>{c.label}</li>
              ))}
            </ul>
          )
        }
        <p class="approach__sign">
          <span class="rule" aria-hidden="true"></span>
          {business.tagline}
        </p>
      </div>
    </div>
  </section>

  <Steps />

  <Reviews />

  <!-- Area + FAQ -->
  <section class="info section" aria-label="Service area and questions">
    <div class="wrap info__grid">
      <ServiceArea />
      <div class="info__faq">
        <h2>Questions</h2>
        <FaqList />
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    overflow: hidden;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 44fr) minmax(0, 56fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-weight: 600;
    color: var(--burgundy);
    margin-bottom: var(--space-l);
  }

  .hero__eyebrow::after {
    content: '';
    width: 2.5rem;
    height: 1px;
    background: var(--gold);
  }

  .hero h1 {
    max-width: 11em;
  }

  .hero__lede {
    margin-top: var(--space-l);
    max-width: 26em;
  }

  .hero__ctas {
    margin-top: var(--space-xl);
  }

  .hero__area {
    margin-top: var(--space-l);
    max-width: 28em;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .hero__trust {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
    max-width: 36rem;
  }

  /* Blush field behind the photo, bleeding to the right edge. */
  .hero__media {
    position: relative;
    display: flex;
    justify-content: center;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .hero__media::before {
    content: '';
    position: absolute;
    inset: 0 calc(-50vw) 0 18%;
    background: var(--blush);
    border-radius: var(--radius-img) 0 0 var(--radius-img);
    z-index: -1;
  }

  .hero__media :global(.reveal) {
    max-width: 30rem;
  }

  .hero__caption {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .hero__caption a {
    color: var(--burgundy);
    white-space: nowrap;
  }

  @media (max-width: 47.99em) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__media {
      padding-block: 0;
    }

    .hero__media::before {
      inset: 12% calc(-1 * var(--gutter)) -1.5rem 22%;
      border-radius: var(--radius-img) 0 0 var(--radius-img);
    }
  }

  @media (min-width: 48em) and (max-width: 63.99em) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  /* ---------- Services ---------- */
  .services__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-xl) clamp(2rem, 1rem + 4vw, 5rem);
    align-items: end;
  }

  .services__head h2 {
    max-width: 13em;
  }

  .services__intro {
    max-width: 28em;
    color: var(--muted);
  }

  .services__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.25rem, 0.5rem + 2vw, 2rem);
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .service {
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    border-radius: var(--radius-img);
  }

  .service--general {
    background: var(--white);
    border: 1px solid var(--line);
  }

  .service--bond {
    background: var(--blush);
  }

  .service h3 {
    font-size: var(--step-3);
  }

  .service--bond h3 {
    font-size: var(--step-2);
  }

  .service__summary {
    margin-top: var(--space-m);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--charcoal);
    max-width: 22em;
  }

  .service__meta {
    margin-top: var(--space-s);
    color: var(--muted);
    max-width: 30em;
  }

  .service__list {
    list-style: none;
    margin: var(--space-xl) 0;
    border-top: 1px solid var(--line);
  }

  .service--bond .service__list {
    border-color: var(--blush-deep);
  }

  .service__list li {
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--line);
  }

  .service--bond .service__list li {
    border-color: var(--blush-deep);
  }

  .service__tag {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .service .text-link {
    margin-top: auto;
    align-self: flex-start;
    padding-block: 0.4rem;
  }

  .services__more {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl) clamp(1.25rem, 0.5rem + 2vw, 2rem);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }

  .services__more h3 {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }

  .services__more p {
    color: var(--charcoal);
    max-width: 32em;
  }

  .services__more a {
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 59.99em) {
    .services__head,
    .services__grid,
    .services__more {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Our work ---------- */
  .work {
    background: var(--blush);
  }

  .work__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .work__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
    max-width: 38rem;
  }

  .work__photos figure {
    margin: 0;
  }

  .work__photos img {
    width: 100%;
    aspect-ratio: 504 / 1041;
    object-fit: cover;
    border-radius: var(--radius-img);
  }

  .work__photos figcaption {
    margin-top: var(--space-xs);
    font-weight: 600;
    color: var(--burgundy);
  }

  .work__copy > * + * {
    margin-top: var(--space-l);
  }

  .work__copy h2 {
    max-width: 10em;
  }

  .work__copy p {
    max-width: 30em;
  }

  .work__more {
    color: var(--muted);
  }

  @media (max-width: 47.99em) {
    .work__grid {
      grid-template-columns: 1fr;
    }
    .work__copy {
      order: -1;
    }
  }

  /* ---------- Approach ---------- */
  .approach__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-xl) clamp(2rem, 1rem + 5vw, 6rem);
    align-items: start;
  }

  .approach h2 {
    max-width: 11em;
  }

  .approach__body > * + * {
    margin-top: var(--space-l);
  }

  .approach__body p {
    max-width: 34em;
  }

  .approach__claims {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
    padding-block: var(--space-m);
    border-block: 1px solid var(--line);
    font-weight: 600;
    color: var(--burgundy);
  }

  .approach__claims li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .approach__claims li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }

  .approach__sign {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--burgundy);
  }

  @media (max-width: 59.99em) {
    .approach__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Area + FAQ ---------- */
  .info {
    border-top: 1px solid var(--line);
  }

  .info__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-3xl) clamp(2rem, 1rem + 5vw, 6rem);
    align-items: start;
  }

  .info__faq h2 {
    margin-bottom: var(--space-l);
  }

  @media (max-width: 59.99em) {
    .info__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
