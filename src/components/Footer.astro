---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { business, services, isPublished } from '../content/site';

import { execSync } from 'node:child_process';

const year = new Date().getFullYear();

// Demo builds (no SITE_URL yet) show a short build code, so it's easy to
// confirm which version is live. Hidden once the real domain is configured.
let build = (process.env.WORKERS_CI_COMMIT_SHA ?? process.env.CF_PAGES_COMMIT_SHA ?? '').slice(0, 7);
if (!build) {
  try {
    build = execSync('git rev-parse --short=7 HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
  } catch {
    build = '';
  }
}
const showBuild = !Astro.site && Boolean(build);
const socials = Object.values(business.social).filter((s) => s.publish);
---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <Image src={logo} alt={`${business.name} logo: a pink hibiscus with the words ${business.tagline}`} width={168} height={168} densities={[1, 2]} loading="lazy" class="site-footer__logo" />
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Get in touch</h2>
      <p>
        <a class="site-footer__phone" href={business.phone.href} data-cta="footer">{business.phone.display}</a>
      </p>
      {
        isPublished(business.hours) && (
          <dl class="site-footer__hours">
            {business.hours.rows.map((r) => (
              <div>
                <dt>{r.days}</dt>
                <dd>{r.label}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <p class="muted site-footer__base-loc">Serving the Moreton Bay region</p>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Services</h2>
      <ul class="site-footer__links">
        <li><a href={services.general.href}>{services.general.name}</a></li>
        <li><a href={services.bond.href}>{services.bond.name}</a></li>
        <li><a href="/contact">Contact and service area</a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Follow</h2>
      <ul class="site-footer__links">
        {
          socials.map((s) => (
            <li>
              <a href={s.url} rel="noopener" target="_blank">
                {s.label}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="wrap site-footer__base">
    <p>
      &copy; {year} {business.name}
      {showBuild && <span class="site-footer__build">Demo build {build}</span>}
    </p>
    <p><a href="/privacy">Privacy</a></p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--blush);
    color: var(--charcoal);
    padding-top: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: auto repeat(3, minmax(0, 1fr));
    gap: var(--space-2xl) clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: start;
  }

  .site-footer__logo {
    width: 168px;
    height: 168px;
    border-radius: 50%;
  }

  .site-footer__heading {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    color: var(--burgundy);
    letter-spacing: 0;
    margin-bottom: var(--space-s);
  }

  .site-footer__phone {
    font-family: var(--font-serif);
    font-size: 1.625rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-footer__hours {
    margin: var(--space-s) 0;
    font-size: var(--step--1);
  }

  .site-footer__hours div {
    display: flex;
    gap: 0.5em;
    flex-wrap: wrap;
  }

  .site-footer__hours dt::after {
    content: ':';
  }

  .site-footer__hours dd {
    margin: 0;
  }

  .site-footer__links {
    list-style: none;
  }

  .site-footer__links a {
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--charcoal);
  }

  .site-footer__links a:hover {
    color: var(--burgundy);
  }

  .site-footer__base-loc {
    font-size: var(--step--1);
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: var(--space-3xl);
    padding-block: var(--space-l) calc(var(--space-l) + var(--bar-h));
    border-top: 1px solid var(--blush-deep);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .site-footer__build {
    margin-left: 0.75em;
    opacity: 0.8;
  }

  .site-footer__base a {
    color: var(--muted);
  }

  @media (max-width: 59.99em) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 34em) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
    .site-footer__logo {
      width: 132px;
      height: 132px;
    }
  }
</style>
