# Final public origin. Leave empty until the domain is live.
SITE_URL=

# Callback form delivery. Leave PUBLIC_FORM_PROVIDER empty to show the
# phone/SMS fallback instead of the form.
#   netlify  → Netlify Forms (site must be deployed on Netlify)
#   endpoint → POST FormData to PUBLIC_FORM_ENDPOINT (Formspree, Web3Forms, own API)
PUBLIC_FORM_PROVIDER=
PUBLIC_FORM_ENDPOINT=
PUBLIC_FORM_ACCESS_KEY=

# true = show the form in preview-only mode (validation works, nothing is sent)
PUBLIC_FORM_PREVIEW=
